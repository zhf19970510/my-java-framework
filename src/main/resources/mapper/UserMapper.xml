<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhf.dao.UserMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.zhf.entity.User">
        <id column="user_id" property="userId" />
        <result column="user_name" property="userName" />
        <result column="age" property="age" />
        <result column="sex" property="sex" />
        <result column="place_of_origin" property="placeOfOrigin" />
        <result column="university" property="university" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 基础列 -->
    <sql id="BaseColumns">
        user_id, user_name, age, sex, place_of_origin, university,
        create_by, create_time, update_by, update_time
    </sql>

    <!-- 单条插入 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="userId" keyColumn="user_id">
        INSERT INTO user (user_name, age, sex, place_of_origin, university, create_by, create_time)
        VALUES (#{userName}, #{age}, #{sex}, #{placeOfOrigin}, #{university}, #{createBy}, NOW())
    </insert>

    <!-- 批量插入（供 Batch Executor 使用，实际走单条循环） -->
    <insert id="insertBatch" useGeneratedKeys="true" keyProperty="userId" keyColumn="user_id">
        INSERT INTO user (user_name, age, sex, place_of_origin, university, create_by, create_time)
        VALUES (#{userName}, #{age}, #{sex}, #{placeOfOrigin}, #{university}, #{createBy}, NOW())
    </insert>

    <!-- 查询所有 -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" />
        FROM user
        ORDER BY create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" />
        FROM user
        WHERE user_id = #{userId}
    </select>

    <!-- 根据姓名模糊查询 -->
    <select id="findByUserName" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" />
        FROM user
        WHERE user_name LIKE CONCAT('%', #{userName}, '%')
    </select>

    <!-- 根据院校查询 -->
    <select id="findByUniversity" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns" />
        FROM user
        WHERE university = #{university}
    </select>

</mapper>